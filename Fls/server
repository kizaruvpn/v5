[Unit]
Description=Server SlowDNS (dnstt)
After=network.target nss-lookup.target

[Service]
Type=simple
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
LimitNOFILE=65535
# xxxx diisi otomatis oleh Fls/nameserver (slowdns) dengan domain NS yang dipilih
ExecStart=/etc/slowdns/dnstt-server -udp :5300 -privkey-file /etc/slowdns/server.key xxxx 127.0.0.1:22
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
